<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IoTSolutions">

        <!-- Activity 1: Inicio de sesión (pantalla de arranque) -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity 2: Bienvenida -->
        <activity android:name=".ui.welcome.WelcomeActivity" android:exported="false" />

        <!-- Activity 3: Perfil de usuario -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity 4: Listado de productos + mantenedor -->
        <activity android:name=".ui.products.ProductListActivity" android:exported="false" />
        <activity
            android:name=".ui.products.ProductDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity 5: Monitoreo de bodega -->
        <activity android:name=".ui.warehouse.WarehouseActivity" android:exported="false" />
    </application>
</manifest>
